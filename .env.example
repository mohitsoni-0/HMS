# DEV-ONLY values for local docker compose; production must inject real secrets.
# The keys below are committed, which makes them public: never use them outside ENVIRONMENT=local.
# docker compose loads this file into the app and scheduler containers; an optional .env overrides it.
# Values are deliberately unquoted so that docker compose and plain KEY=VALUE loaders read them the same.
# Keys are base64 of 32 random bytes.

# Runtime
ENVIRONMENT=local
DJANGO_SECRET_KEY=2xhwSd6YoCMwNLxnazrQw0FqnScHAMhWEjD8i35xWp0RNmgvdUPJbngqcR6oB6EJ
DJANGO_DEBUG=false
API_VERSION=v1

# PostgreSQL: the compose service "postgres"
POSTGRES_NAME=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis: the compose service "redis"
REDIS_URL=redis://redis:6379/0

# Identity: HS256 token signing
JWT_SIGNING_KEY=J1ilWfIL0XotVfdfpySBzaTJ2XndtSotya5QCliW4lM=
JWT_ISSUER=hotel-booking
JWT_AUDIENCE=hotel-booking-api
JWT_TTL_SECONDS=3600

# PII at rest: AES-256-GCM key ring {key id: key}, the active key id, and the blind-index HMAC key
PII_ENCRYPTION_KEYS={"k1": "EfIxmRL0YFO4ayt3Svr0nh5dwGi4V0UWWcJjKoBxglI="}
PII_ACTIVE_KEY_ID=k1
PII_BLIND_INDEX_KEY=D0M1ceR0XA7ImckKaVWhEKAdWD0rjrcRlnBkB6eQ4U8=

# Idempotency-Key request fingerprints (HMAC)
IDEMPOTENCY_FINGERPRINT_KEY=42Ih8POiPsq8hJqodatNNO7ZmENkBNWSGmArcgQhktM=

# API payload encryption: off | optional | enforced. The RSA-3072 key is mounted read-only from secrets/dev.
API_ENCRYPTION_MODE=optional
API_RSA_PRIVATE_KEY_PATH=secrets/dev/api_rsa_private.pem

# Rate limiting; TRUSTED_PROXY_COUNT is the number of proxy hops whose X-Forwarded-For is trusted
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_COUNT=0

# Local demo only: lets POST /hotel/v1/dev/tokens mint ADMIN tokens
DEV_TOKENS_ALLOW_ADMIN=true

# Booking rules
BOOKING_HOLD_TTL_SECONDS=900
INVENTORY_HORIZON_DAYS=365
MAX_STAY_NIGHTS=30
